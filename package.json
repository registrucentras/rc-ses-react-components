{
  "name": "@registrucentras/rc-ses-react-components",
  "author": "VĮ REGISTRŲ CENTRAS",
  "version": "2.0.0-rc.4",
  "description": "RC SES React komponentų biblioteka",
  "type": "module",
  "private": false,
  "main": "./dist/registrucentras-rc-ses-react-components.cjs",
  "module": "./dist/registrucentras-rc-ses-react-components.js",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/registrucentras-rc-ses-react-components.js",
      "require": "./dist/registrucentras-rc-ses-react-components.cjs",
      "default": "./dist/registrucentras-rc-ses-react-components.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "public/*",
    "src/*",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "npm i && tsc --p ./tsconfig.lib.json && vite build --config vite.config.lib.ts && tsc --p ./tsconfig.check-dist.json",
    "check:dist": "tsc --p ./tsconfig.check-dist.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "storybook": "storybook dev -p 6006",
    "storybook-test": "test-storybook",
    "storybook-build": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:ci": "npm run storybook-build && playwright test",
    "test:visual:update": "docker run --rm -v .:/work -v rcses-visual-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.62.0-noble bash -c \"npm ci --no-audit --no-fund && npm run storybook-build && npx playwright test --update-snapshots\"",
    "test:visual:update:new": "docker run --rm -v .:/work -v rcses-visual-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.62.0-noble bash -c \"npm ci --no-audit --no-fund && npm run storybook-build && npx playwright test --update-snapshots missing\"",
    "test:visual:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/registrucentras/rc-ses-react-components.git"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "date-fns": "^3.6.0 || ^4.0.0",
    "date-fns-tz": "^3.2.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.53.2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "countries-phone-masks": "^1.1.1",
    "i18next": "^26.3.6",
    "js-cookie": "^3.0.5",
    "maska": "^3.2.0",
    "react-dropzone": "19.1.1",
    "react-i18next": "^17.0.11",
    "react-window": "^2.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/public-sans": "^5.3.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@mui/material": "9.2.0",
    "@mui/system": "9.2.0",
    "@mui/x-date-pickers": "9.10.1",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-commonjs": "^26.0.3",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-links": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.15",
    "axe-playwright": "^2.0.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.26.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "storybook": "^10.5.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-css-injected-by-js": "^3.5.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.0.15"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.18.0"
  }
}
